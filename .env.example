APP_NAME="Hotel Management Report System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://reports.swissbel-waterfront.local
APP_TIMEZONE=Asia/Makassar
APP_TESTING_LOGIN=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_management_report
DB_USERNAME=sbwm_report_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# POMEC Temporary Preview Retention & AI Chatbot Settings
POMEC_TEMP_TTL_HOURS=2
# ==============================================================================
# AI CHATBOT CONFIGURATION (Tinggal ubah CHATBOT_PROVIDER untuk berpindah AI)
# Pilihan: ollama | gemini | openrouter | openai | local (tanpa AI/hanya keyword)
# Setelah edit .env, jalankan "php artisan optimize:clear" jika config ter-cache.
# ==============================================================================
CHATBOT_PROVIDER=ollama
CHATBOT_TIMEOUT=35
CHATBOT_TIMEOUT_INTENT=12

# --- 1. OLLAMA (Lokal / On-Premise Server Hotel) ---
# Aktif saat CHATBOT_PROVIDER=ollama (tanpa API key, data tidak keluar jaringan)
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions

# --- 2. GOOGLE GEMINI (Cloud AI) ---
# Cara pakai: isi GEMINI_API_KEY lalu ubah CHATBOT_PROVIDER=gemini
# Pilihan model: gemini-3.1-flash-lite (cepat & stabil) | gemini-flash-latest | gemini-3.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- 3. OPENROUTER (Cloud AI - Bebas ganti model Gemini/GPT/Claude/Qwen) ---
# Cara pakai: isi OPENROUTER_API_KEY lalu ubah CHATBOT_PROVIDER=openrouter
# Contoh model: google/gemini-2.5-flash | openai/gpt-4o-mini | anthropic/claude-3.5-sonnet | qwen/qwen-2.5-72b-instruct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- 4. OPENAI (Cloud AI Langsung) ---
# Cara pakai: isi OPENAI_API_KEY lalu ubah CHATBOT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 5. OVERRIDE UMUM / CUSTOM ENDPOINT (Opsional) ---
# CHATBOT_API_KEY=
# CHATBOT_MODEL=
# CHATBOT_ENDPOINT=
CHATBOT_BREAKER_FAILURES=3
CHATBOT_BREAKER_COOLDOWN=120
CHATBOT_RETENTION_DAYS=90
CHATBOT_REVIEW_SLA_DAYS=2
CHATBOT_CHANGE_PCT=10
CHATBOT_WBP_SHARE_PCT=25
